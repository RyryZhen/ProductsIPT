@model List<AssignmentFinals.Models.Product>

@{
    ViewData["Title"] = "Products";
}


<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-danger">🏁 Product Inventory</h2>
            <p class="text-muted mb-0">Showroom Panel</p>
        </div>

        <div class="d-flex gap-2">
            <button id="checkLowStock" class="btn btn-danger shadow-sm">
                Check Low Stock Products
            </button>

            <a asp-controller="Products" asp-action="Create" class="btn btn-outline-danger">
                + Add New Product
            </a>
        </div>

    </div>

    <div class="card mb-3 border-danger shadow-sm">
        <div class="card-header bg-dark text-danger fw-bold">
            Live Alerts
        </div>
        <div class="card-body" id="notifications" style="min-height: 40px;">
            <small class="text-muted">No alerts yet...</small>
        </div>
    </div>

  
    <div class="card shadow-sm border-0">

        <div class="card-header bg-dark text-light">
            Inventory Grid
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-dark table-hover align-middle mb-0">

                    <thead class="table-danger text-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Quantity</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-bold text-danger">@item.ProductID</td>
                                <td>@item.ProductName</td>
                                <td>@item.Category</td>
                                <td>₱@item.Price</td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @item.Quantity
                                    </span>
                                </td>

                                <td>
                                    @if (item.Status == "Available")
                                    {
                                        <span class="badge bg-success">Available</span>
                                    }
                                    else if (item.Status == "Low Stock")
                                    {
                                        <span class="badge bg-warning text-dark">Low Stock</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Out of Stock</span>
                                    }
                                </td>

                                <td class="d-flex gap-2">

                                    <a asp-controller="Products" asp-action="Edit" asp-route-id="@item.ProductID"
                                       class="btn btn-sm btn-outline-light">
                                        Edit
                                    </a>

                                    <form asp-controller="Products" asp-action="Delete" method="post">

                                        <input type="hidden" name="id" value="@item.ProductID" />

                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {

    const connection = new signalR.HubConnectionBuilder()
    .withUrl("/inventoryHub")
    .build();

    const div = document.getElementById("notifications");
    const button = document.getElementById("checkLowStock");

    let isVisible = false; // 🔥 TOGGLE STATE

    // Receive messages
    connection.on("ReceiveLowStockAlert", function (message) {
    const p = document.createElement("p");
    p.innerText = message;
    div.appendChild(p);
    });

    // Start connection
    async function startConnection() {
    try {
    await connection.start();
    console.log("SignalR connected");
    } catch (err) {
    console.error("SignalR connection failed:", err);
    setTimeout(startConnection, 3000);
    }
    }

    startConnection();

    if (!button) {
    console.error("Button not found!");
    return;
    }

    button.addEventListener("click", async () => {

    console.log("BUTTON CLICKED");

    // 🔥 TOGGLE OFF (2nd click)
    if (isVisible) {
    div.innerHTML = "";
    isVisible = false;
    return;
    }

    try {
    const response = await fetch("/api/products/lowstock");

    if (!response.ok) {
    console.error("API failed:", response.status);
    return;
    }

    const products = await response.json();

    console.log("Low stock products:", products);

    if (!products || products.length === 0) {
    alert("No low stock products found.");
    return;
    }

    div.innerHTML = ""; // clear before showing

    for (const product of products) {

    const message =
    `Low stock alert: ${product.productName} has only ${product.quantity} unit(s) left.`;

    if (connection.state === "Connected") {
    await connection.invoke("BroadcastLowStock", message);
    } else {
    console.warn("SignalR not connected yet");
    }
    }

    isVisible = true; // 🔥 mark as shown

    } catch (error) {
    console.error("Button click error:", error);
    }
    });

    });
</script>