@model AssignmentFinals.Models.Product

@{
    ViewData["Title"] = "Add Product";
}

<div class="container mt-5" style="max-width: 650px;">

    <div class="card shadow-lg border-0" style="background: rgba(20,20,20,0.9);
        border: 1px solid rgba(255,0,0,0.3);
        border-radius: 14px;">

        <div class="card-header bg-dark text-success py-3" style="border-bottom: 1px solid rgba(255,0,0,0.3);">

            <h4 class="mb-0 fw-bold text-danger">
                Create Product Record
            </h4>

        </div>

        <div class="card-body p-4 text-light">

            <form asp-action="Create" method="post">

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label fw-semibold text-light">
                        Product Name
                    </label>
                    <input asp-for="ProductName" class="form-control bg-dark text-light border-danger" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Category" class="form-label fw-semibold text-light">
                        Category
                    </label>
                    <input asp-for="Category" class="form-control bg-dark text-light border-danger" required />
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label fw-semibold text-light">
                            Price (₱)
                        </label>
                        <input asp-for="Price" type="number" step="0.01"
                               class="form-control bg-dark text-light border-danger" required />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Quantity" class="form-label fw-semibold text-light">
                            Quantity
                        </label>
                        <input asp-for="Quantity" type="number" class="form-control bg-dark text-light border-danger"
                               required />
                    </div>

                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index" class="btn btn-outline-light px-4 border-danger">
                        Cancel
                    </a>

                    <button type="submit" class="btn btn-danger px-4 fw-bold shadow-sm">
                        Save Product
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>