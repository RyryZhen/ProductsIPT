@model AssignmentFinals.Models.Product

@{
    ViewData["Title"] = "Edit Product";
    Layout = "_Layout";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">

            <div class="card border-0 shadow-lg rounded-4 bg-dark text-light"
                 style="border: 1px solid rgba(255,0,0,0.25);">

                <div class="card-header text-center py-3"
                     style="background: linear-gradient(90deg, #ff0000, #660000); color: white;">
                    <h4 class="mb-0 fw-bold">
                        🏍 Modify Product ##@Model.ProductID
                    </h4>
                    <small class="text-light opacity-75">
                        MotoGP Showroom Control Panel
                    </small>
                </div>

                <div class="card-body p-4">

                    <form asp-action="Edit" method="post">

                        <input type="hidden" asp-for="ProductID" />

                        <div class="mb-3">
                            <label asp-for="ProductName" class="form-label fw-semibold text-danger">
                                Product Name
                            </label>
                            <input asp-for="ProductName" class="form-control bg-dark text-light border-danger"
                                   required />
                            <span asp-validation-for="ProductName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category" class="form-label fw-semibold text-danger">
                                Category
                            </label>
                            <input asp-for="Category" class="form-control bg-dark text-light border-danger" required />
                            <span asp-validation-for="Category" class="text-danger"></span>
                        </div>

                        <div class="row">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label fw-semibold text-danger">
                                    Price
                                </label>
                                <input asp-for="Price" class="form-control bg-dark text-light border-danger"
                                       type="number" step="0.01" required />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Quantity" class="form-label fw-semibold text-danger">
                                    Quantity
                                </label>
                                <input asp-for="Quantity" class="form-control bg-dark text-light border-danger"
                                       type="number" required />
                                <span asp-validation-for="Quantity" class="text-danger"></span>
                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index" class="btn btn-outline-light px-4">
                                Cancel
                            </a>

                            <button type="submit" class="btn px-4 fw-bold text-white"
                                    style="background: linear-gradient(45deg, #ff0000, #990000);">
                                Save Changes
                            </button>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>